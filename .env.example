# ==============================================================================
# BUSINESS DOCTOR AI — ENVIRONMENT VARIABLE CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED PRODUCTION SECRETS (Server-Side Only — Never Exposed to Browser)
# ------------------------------------------------------------------------------

# GEMINI_API_KEY: Required for Gemini AI API calls (autonomous diagnoses, marketing copywriting, trial planning).
# AI Studio automatically injects this at runtime from user secrets.
# In production platforms (Cloud Run, Vercel, Railway, etc.), configure this in Secret Manager / Environment Secrets.
GEMINI_API_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: Optional backend administrative key for privileged server-side operations
# and administrative token inspection. Do NOT prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=""

# WHATSAPP_WEBHOOK_VERIFY_TOKEN: Secret token used by Meta WhatsApp Cloud API to verify the webhook endpoint.
# Server-side only. Never expose to frontend. Configure in Meta Developer App -> WhatsApp -> Configuration -> Callback URL.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# WHATSAPP_APP_SECRET: Optional Meta App Secret used for validating X-Hub-Signature-256 HMAC on incoming webhooks.
WHATSAPP_APP_SECRET=""


# ------------------------------------------------------------------------------
# 2. PUBLIC CLIENT CONFIGURATION (Safe for Browser Bundle)
# ------------------------------------------------------------------------------

# VITE_SUPABASE_URL: The REST/GraphQL endpoint of your Supabase project (e.g., https://your-project.supabase.co)
VITE_SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: The public anonymous API key for your Supabase project (enforces PostgreSQL RLS policies).
VITE_SUPABASE_ANON_KEY=""

# APP_URL: The publicly accessible base URL of the hosted application (e.g., https://your-app.run.app)
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=""


# ------------------------------------------------------------------------------
# 3. OPTIONAL DEVELOPMENT VARIABLES
# ------------------------------------------------------------------------------

# PORT: Hosting platform ingress port. Locally defaults to 3000; Render supplies this automatically.
# PORT=3000

# NODE_ENV: Application environment ('development' | 'production' | 'test')
# NODE_ENV=production
